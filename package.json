{
  "name": "fyn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "concurrently -n web,parser -c blue,magenta \"pnpm --dir app dev\" \"pnpm parser\"",
    "parser": "cd parser && .venv/bin/uvicorn main:app --port 8000 --reload",
    "setup": "node scripts/setup.mjs",
    "build": "pnpm --dir app build",
    "start": "pnpm --dir app start",
    "perf:fixture": "pnpm --dir app exec tsx ../scripts/perf/generate-db.ts",
    "perf:explain": "pnpm --dir app exec tsx ../scripts/perf/explain.ts",
    "perf:http": "node scripts/perf/http-timing.mjs",
    "perf:parser": "parser/.venv/bin/python scripts/perf/parser-timing.py",
    "migrate": "pnpm --dir app db:migrate",
    "test": "pnpm --dir app test && pnpm test:parser",
    "test:parser": "cd parser && .venv/bin/pytest"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
